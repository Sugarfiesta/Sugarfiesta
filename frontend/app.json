{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.randommatch.ejoaem",
      "infoPlist": {
        "NSCameraUsageDescription": "Live-Video mit deinem Match zeigen",
        "NSMicrophoneUsageDescription": "Sprich live mit deinem Match",
        "NSPhotoLibraryUsageDescription": "Selfie zur Verifizierung auswählen"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.randommatch.ejoaem",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Live-Video mit deinem Match zeigen",
          "microphonePermission": "Sprich live mit deinem Match"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selfie zur Verifizierung auswählen",
          "cameraPermission": "Selfie zur Verifizierung aufnehmen"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
